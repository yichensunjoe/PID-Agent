# ==============================================================================
# P&ID-Agent 环境配置示例 (.env.example)
# 复制本文件为 .env 并按需修改配置，或直接使用默认值开箱即用。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务与部署配置
# ------------------------------------------------------------------------------
# 部署模式：local（单机/本地无鉴权模式）或 shared（多租户/令牌鉴权模式）
PID_AGENT_DEPLOYMENT_MODE=local

# 共享模式下的访问令牌（当 PID_AGENT_DEPLOYMENT_MODE=shared 时必填）
# PID_AGENT_API_TOKEN=your-secure-access-token

# SQLite 数据库存储路径（默认位于项目 data/ 目录下）
PID_AGENT_DATABASE_PATH=./data/pid-agent.db

# 诊断事件日志路径（为空时自动与数据库同目录）
# PID_AGENT_DIAGNOSTICS_PATH=./data/pid-agent.diagnostics.jsonl

# 前端静态资源构建目录
PID_AGENT_FRONTEND_DIST=./frontend/dist

# 允许跨域的 Origins（逗号分隔）
PID_AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. AI / LLM 辅助设计配置（可选）
# 用户亦可在 Web 前端界面实时填写 API Key 与选择模型；若在此配置则作为服务端全局默认
# ------------------------------------------------------------------------------
# 默认 OpenAI-compatible API 端点（例如本地 Ollama 或云端 API）
# PID_AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# PID_AGENT_LLM_MODEL=qwen2.5:14b
# PID_AGENT_LLM_API_KEY=

# LLM 调用的全局超时时间（秒，最大 600）
PID_AGENT_AGENT_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------------
# 3. 网络与安全边界策略（可选）
# ------------------------------------------------------------------------------
# 允许连接的 LLM Provider 主机名白名单（逗号分隔，留空表示按部署模式策略放行）
# PID_AGENT_PROVIDER_ALLOW_HOSTS=api.openai.com,api.example.com,internal-llm.corp

# ------------------------------------------------------------------------------
# 4. 图例与符号库扩展（可选）
# ------------------------------------------------------------------------------
# 自定义企业图例目录路径（逗号分隔）
# PID_AGENT_SYMBOL_PATHS=./custom-symbols
